.pio_version 1
.program snes_sysclk_counter
; GP41 = SNES SYSTEM CLK. Input only.
; PIO2 GPIO base is 16, so GP41 is within its 16..47 window.
; in_base/wait pin 0 is configured to GP41 by main.c.
; Emit one RX token for every 1024 complete master-clock cycles.
.wrap_target
    set y, 31
outer:
    set x, 31
inner:
    wait 1 pin 0
    wait 0 pin 0
    jmp x-- inner
    jmp y-- outer
    mov isr, null
    push block
.wrap
