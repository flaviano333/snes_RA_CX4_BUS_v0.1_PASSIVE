.pio_version 1
.program snes_bus_drive_split
; PIO0 shared program for SM2 and SM3. GPIO base = 0.
;
;   SM2: X=0, IN base GP11 (A0), OUT/SET base GP2  -> D0..D2 (3 bits)
;   SM3: X=1, IN base GP14 (A3), OUT/SET base GP6  -> D3..D7 (5 bits)
;
; Cross-PIO start:
;   WAIT IRQ 0 REL -> IRQ2 on SM2, IRQ3 on SM3.
; Cross-PIO release:
;   WAIT IRQ 2 REL -> IRQ4 on SM2, IRQ5 on SM3.
;
; PIO2 emits release only when physical /RD actually rises, so D0-D7 stay
; valid for the complete CPU read window. /WR is rechecked before driving.
.wrap_target
drive_loop:
    wait 1 irq 0 rel
    jmp pin read_not_write     ; GP1 /WR HIGH => genuine read
    jmp no_drive_release
read_not_write:
    jmp !x low_three

high_five:
    mov isr, null
    in pins, 5
    mov osr, isr
    out pins, 5
    set pindirs, 31
    jmp hold_until_rd_release

low_three:
    mov isr, null
    in pins, 3
    mov osr, isr
    out pins, 3
    set pindirs, 31

hold_until_rd_release:
    wait 1 irq 2 rel
    set pindirs, 0
    jmp drive_loop

no_drive_release:
    wait 1 irq 2 rel
    jmp drive_loop
.wrap
