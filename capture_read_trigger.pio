.pio_version 1
.program snes_read_trigger
; RP2350B PIO2, GPIO base = 16
;
; SM0: physical /RD detector + settled /ROMSEL first-stage gate.
;   GP35 /RD     -> WAIT GPIO index 19 (35-16)
;   GP38 /ROMSEL -> JMP PIN configured by C
;
; After a short settle delay, LOW /ROMSEL is a genuine cartridge-ROM access. Such a cycle is never
; forwarded to the active responder. A HIGH /ROMSEL read raises local PIO2
; IRQ4 for SM1 to apply the /WRAMSEL gate.
.wrap_target
rd_loop:
    wait 0 gpio 19
    nop [3]                 ; allow /ROMSEL to settle after /RD falls
    jmp pin romsel_open
    jmp rd_release
romsel_open:
    irq 4
rd_release:
    wait 1 gpio 19
    jmp rd_loop
.wrap

.program snes_drive_qualifier
; PIO2 SM1: second-stage /WRAMSEL gate.
; JMP PIN is physical GP39 /WRAMSEL, active LOW.
;
; Only reads with BOTH /ROMSEL HIGH and /WRAMSEL HIGH reach PIO0.
; IRQ2 and IRQ3 are separate so two PIO0 data state machines can consume the
; same qualified /RD event without racing over one IRQ flag.
.wrap_target
qual_loop:
    wait 1 irq 4
    jmp pin qualified
    jmp qual_loop
qualified:
    irq next 2
    irq next 3
    jmp qual_loop
.wrap
