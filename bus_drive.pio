.pio_version 1
.program snes_bus_drive_split
; PIO0 shared program for SM2 and SM3. GPIO base = 0.
;
; The final validator does not ask Core1 to calculate a byte during /RD.
; Instead the test ROM expects DATA = A0..A7. The two state machines sample
; those address bits directly in PIO and copy them onto the split D bus:
;
;   SM2: X=0, IN base GP11 (A0), OUT/SET base GP2  -> D0..D2 (3 bits)
;   SM3: X=1, IN base GP14 (A3), OUT/SET base GP6  -> D3..D7 (5 bits)
;
; WAIT IRQ 0 REL maps to IRQ2 on SM2 and IRQ3 on SM3. PIO2 only publishes
; those IRQs when /RD is LOW, /ROMSEL is HIGH and /WRAMSEL is HIGH.
; Both SMs remain disabled except for the READ phase of one BUSARM validation pass.
; Each SM re-checks /WR=HIGH before changing any data-pin direction.
.wrap_target
drive_loop:
    wait 1 irq 0 rel
    jmp pin read_not_write     ; JMP pin = GP1 /WR. LOW => never drive
    jmp drive_loop
read_not_write:
    jmp !x low_three

high_five:
    mov isr, null
    in pins, 5
    mov osr, isr
    out pins, 5
    set pindirs, 31
    jmp hold_until_phi_fall

low_three:
    mov isr, null
    in pins, 3
    mov osr, isr
    out pins, 3
    set pindirs, 31

hold_until_phi_fall:
    wait 0 gpio 0
    set pindirs, 0
    jmp drive_loop
.wrap
